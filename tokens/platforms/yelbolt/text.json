{
  "text": {
    "fontFamily": {
      "$value": "Lexend",
      "$type": "fontFamilies"
    },
    "color": {
      "primary": {
        "$value": "{color.text.primary.default}",
        "$type": "color"
      },
      "secondary": {
        "$value": "{color.text.secondary.default}",
        "$type": "color"
      },
      "tertiary": {
        "$value": "{color.text.tertiary.default}",
        "$type": "color"
      },
      "success": {
        "$value": "{color.text.success.default}",
        "$type": "color"
      },
      "warning": {
        "$value": "{color.text.warning.default}",
        "$type": "color"
      },
      "alert": {
        "$value": "{color.text.danger.default}",
        "$type": "color"
      },
      "inverse": {
        "$value": "{color.text.onInverse.default}",
        "$type": "color"
      }
    },
    "fontWeight": {
      "medium": {
        "$value": "{type.weight.500}",
        "$type": "fontWeights"
      },
      "bold": {
        "$value": "{type.weight.600}",
        "$type": "fontWeights"
      }
    },
    "styles": {
      "default": {
        "fontFamily": {
          "$value": "{text.fontFamily}",
          "$type": "fontFamilies"
        },
        "fontSize": {
          "$value": "{type.size.02}",
          "$type": "dimension"
        },
        "fontWeight": {
          "$value": "{type.weight.500}",
          "$type": "fontWeights"
        },
        "lineHeight": {
          "$value": "{type.leading.default}",
          "$type": "number"
        },
        "letterSpacing": {
          "$value": "{type.tracking.xlarge}",
          "$type": "dimension"
        }
      },
      "small": {
        "fontFamily": {
          "$value": "{text.fontFamily}",
          "$type": "fontFamilies"
        },
        "fontSize": {
          "$value": "{type.size.01}",
          "$type": "dimension"
        },
        "fontWeight": {
          "$value": "{type.weight.500}",
          "$type": "fontWeights"
        },
        "lineHeight": {
          "$value": "{type.leading.default}",
          "$type": "number"
        },
        "letterSpacing": {
          "$value": "{type.tracking.xlarge}",
          "$type": "dimension"
        }
      },
      "large": {
        "fontFamily": {
          "$value": "{text.fontFamily}",
          "$type": "fontFamilies"
        },
        "fontSize": {
          "$value": "{type.size.04}",
          "$type": "dimension"
        },
        "fontWeight": {
          "$value": "{type.weight.500}",
          "$type": "fontWeights"
        },
        "lineHeight": {
          "$value": "{type.leading.large}",
          "$type": "number"
        },
        "letterSpacing": {
          "$value": "{type.tracking.medium}",
          "$type": "dimension"
        }
      },
      "xlarge": {
        "fontFamily": {
          "$value": "{text.fontFamily}",
          "$type": "fontFamilies"
        },
        "fontSize": {
          "$value": "{type.size.05}",
          "$type": "dimension"
        },
        "fontWeight": {
          "$value": "{type.weight.500}",
          "$type": "fontWeights"
        },
        "lineHeight": {
          "$value": "{type.leading.large}",
          "$type": "number"
        },
        "letterSpacing": {
          "$value": "{type.tracking.small}",
          "$type": "dimension"
        }
      },
      "link": {
        "color": {
          "$value": "{color.text.brand.default}",
          "$type": "color"
        },
        "decoration": {
          "$value": "none",
          "$type": "string"
        },
        "borderFocus": {
          "$value": "none",
          "$type": "string"
        },
        "decorationFocus": {
          "$value": "underline",
          "$type": "string"
        }
      },
      "label": {
        "color": {
          "$value": "{color.text.tertiary.default}",
          "$type": "color"
        },
        "height": {
          "$value": "{control.size.800}",
          "$type": "dimension"
        },
        "padding": {
          "top": {
            "$value": "{space.none}",
            "$type": "dimension"
          },
          "right": {
            "$value": "{space.inset.100}",
            "$type": "dimension"
          },
          "bottom": {
            "$value": "{space.none}",
            "$type": "dimension"
          },
          "left": {
            "$value": "{space.inset.200}",
            "$type": "dimension"
          }
        },
        "gap": {
          "$value": "{space.gap.100}",
          "$type": "dimension"
        }
      }
    },
    "default": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{text.styles.default.fontFamily}",
        "fontSize": "{text.styles.default.fontSize}",
        "fontWeight": "{text.styles.default.fontWeight}",
        "lineHeight": "{text.styles.default.lineHeight}",
        "letterSpacing": "{text.styles.default.letterSpacing}"
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{text.styles.small.fontFamily}",
        "fontSize": "{text.styles.small.fontSize}",
        "fontWeight": "{text.styles.small.fontWeight}",
        "lineHeight": "{text.styles.small.lineHeight}",
        "letterSpacing": "{text.styles.small.letterSpacing}"
      }
    },
    "large": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{text.styles.large.fontFamily}",
        "fontSize": "{text.styles.large.fontSize}",
        "fontWeight": "{text.styles.large.fontWeight}",
        "lineHeight": "{text.styles.large.lineHeight}",
        "letterSpacing": "{text.styles.large.letterSpacing}"
      }
    },
    "xlarge": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{text.styles.xlarge.fontFamily}",
        "fontSize": "{text.styles.xlarge.fontSize}",
        "fontWeight": "{text.styles.xlarge.fontWeight}",
        "lineHeight": "{text.styles.xlarge.lineHeight}",
        "letterSpacing": "{text.styles.xlarge.letterSpacing}"
      }
    },
    "link": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{text.styles.default.fontFamily}",
        "fontSize": "{text.styles.default.fontSize}",
        "fontWeight": "{text.styles.default.fontWeight}",
        "lineHeight": "{text.styles.default.lineHeight}",
        "letterSpacing": "{text.styles.default.letterSpacing}",
        "textDecoration": "underline"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{text.styles.default.fontFamily}",
        "fontSize": "{text.styles.default.fontSize}",
        "fontWeight": "{text.styles.default.fontWeight}",
        "lineHeight": "{text.styles.default.lineHeight}",
        "letterSpacing": "{text.styles.default.letterSpacing}"
      }
    }
  }
}
