{
  "chip": {
    "gap": {
      "$value": "{space.gap.100}",
      "$type": "dimension"
    },
    "padding": {
      "top": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "right": {
        "$value": "{space.inset.100}",
        "$type": "dimension"
      },
      "bottom": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "left": {
        "$value": "{space.inset.100}",
        "$type": "dimension"
      }
    },
    "height": {
      "$value": "{control.size.400}",
      "$type": "dimension"
    },
    "margin": {
      "top": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "right": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "bottom": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "left": {
        "$value": "{space.offset.200}",
        "$type": "dimension"
      }
    },
    "radius": {
      "$value": "{radius.small}",
      "$type": "dimension"
    },
    "text": {
      "color": {
        "default": {
          "$value": "{color.text.brand.default}",
          "$type": "color"
        },
        "inactive": {
          "$value": "{color.text.primary.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.text.brand.default}",
          "$type": "color"
        },
        "onBackground": {
          "$value": "{grey.1000}",
          "$type": "color"
        }
      },
      "weight": {
        "default": {
          "$value": "{type.weight.450}",
          "$type": "fontWeights"
        },
        "onBackground": {
          "$value": "{type.weight.400}",
          "$type": "fontWeights"
        }
      },
      "size": {
        "$value": "{type.size.01}",
        "$type": "dimension"
      },
      "letterSpacing": {
        "$value": "{type.tracking.xlarge}",
        "$type": "dimension"
      },
      "transform": {
        "$value": "none",
        "$type": "string"
      }
    },
    "background": {
      "color": {
        "default": {
          "$value": "{color.background.selected.default}",
          "$type": "color"
        },
        "inactive": {
          "$value": "{color.background.tertiary.default}",
          "$type": "color"
        },
        "hover": {
          "$value": "{color.background.selected.hover}",
          "$type": "color"
        },
        "onBackground": {
          "$value": "rgba(255, 255, 255, 0.4)",
          "$type": "color"
        }
      }
    },
    "border": {
      "color": {
        "default": {
          "$value": "{grey.transparent}",
          "$type": "color"
        },
        "inactive": {
          "$value": "{grey.transparent}",
          "$type": "color"
        },
        "hover": {
          "$value": "{grey.transparent}",
          "$type": "color"
        },
        "onBackground": {
          "$value": "{grey.transparent}",
          "$type": "color"
        }
      },
      "width": {
        "default": {
          "$value": "{stroke.width.none}",
          "$type": "dimension"
        },
        "inactive": {
          "$value": "{stroke.width.none}",
          "$type": "dimension"
        },
        "hover": {
          "$value": "{stroke.width.none}",
          "$type": "dimension"
        },
        "onBackground": {
          "$value": "{stroke.width.none}",
          "$type": "dimension"
        }
      },
      "offset": {
        "default": {
          "$value": "{stroke.offset.none}",
          "$type": "dimension"
        },
        "inactive": {
          "$value": "{stroke.offset.none}",
          "$type": "dimension"
        },
        "hover": {
          "$value": "{stroke.offset.none}",
          "$type": "dimension"
        },
        "onBackground": {
          "$value": "{stroke.offset.none}",
          "$type": "dimension"
        }
      }
    }
  }
}
