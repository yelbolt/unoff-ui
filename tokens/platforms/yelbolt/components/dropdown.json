        "$value": "{motion.transform.none}",
        "$type": "string"
      },
      "pressed": {
        "$value": "{motion.transform.sink}",
        "$type": "string"
      },
      "focus": {
        "$value": "{motion.transform.none}",
        "$type": "string"
      },
      "disabled": {
        "$value": "{motion.transform.none}",
        "$type": "string"
      }
