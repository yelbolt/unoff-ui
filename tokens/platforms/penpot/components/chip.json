{
  "chip": {
    "gap": {
      "$value": "{space.gap.100}",
      "$type": "dimension"
    },
    "padding": {
      "top": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "right": {
        "$value": "{space.inset.100}",
        "$type": "dimension"
      },
      "bottom": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "left": {
        "$value": "{space.inset.100}",
        "$type": "dimension"
      }
    },
    "height": {
      "$value": "{control.size.400}",
      "$type": "dimension"
    },
    "margin": {
      "top": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "right": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "bottom": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "left": {
        "$value": "{space.offset.200}",
        "$type": "dimension"
      }
    },
    "radius": {
      "$value": "{radius.large}",
      "$type": "dimension"
    },
    "text": {
      "color": {
        "default": {
          "$value": "{penpot.color.accent.primary.default}",
          "$type": "color"
        },
        "inactive": {
          "$value": "{penpot.color.foreground.secondary}",
          "$type": "color"
        },
        "hover": {
          "$value": "{penpot.color.foreground.primary}",
          "$type": "color"
        },
        "onBackground": {
          "$value": "{grey.1000}",
          "$type": "color"
        }
      },
      "weight": {
        "default": {
          "$value": "{type.weight.450}",
          "$type": "fontWeights"
        },
        "onBackground": {
          "$value": "{type.weight.400}",
          "$type": "fontWeights"
        }
      },
      "size": {
        "$value": "{type.size.01}",
        "$type": "dimension"
      },
      "letterSpacing": {
        "$value": "{type.tracking.xlarge}",
        "$type": "dimension"
      },
      "transform": {
        "$value": "uppercase",
        "$type": "string"
      }
    },
    "background": {
      "color": {
        "default": {
          "$value": "{penpot.color.accent.primary.muted}",
          "$type": "color"
        },
        "inactive": {
          "$value": "{penpot.color.background.tertiary}",
          "$type": "color"
        },
        "hover": {
          "$value": "{penpot.color.accent.tertiary}",
          "$type": "color"
        },
        "onBackground": {
          "$value": "rgba(255, 255, 255, 0.4)",
          "$type": "color"
        }
      }
    },
    "border": {
      "color": {
        "default": {
          "$value": "{grey.transparent}",
          "$type": "color"
        },
        "inactive": {
          "$value": "{grey.transparent}",
          "$type": "color"
        },
        "hover": {
          "$value": "{penpot.color.accent.tertiary}",
          "$type": "color"
        },
        "onBackground": {
          "$value": "{grey.transparent}",
          "$type": "color"
        }
      },
      "width": {
        "default": {
          "$value": "{stroke.width.none}",
          "$type": "dimension"
        },
        "inactive": {
          "$value": "{stroke.width.none}",
          "$type": "dimension"
        },
        "hover": {
          "$value": "{stroke.width.thin}",
          "$type": "dimension"
        },
        "onBackground": {
          "$value": "{stroke.width.none}",
          "$type": "dimension"
        }
      },
      "offset": {
        "default": {
          "$value": "{stroke.offset.none}",
          "$type": "dimension"
        },
        "inactive": {
          "$value": "{stroke.offset.none}",
          "$type": "dimension"
        },
        "hover": {
          "$value": "{stroke.offset.thin}",
          "$type": "dimension"
        },
        "onBackground": {
          "$value": "{stroke.offset.none}",
          "$type": "dimension"
        }
      }
    },
    "transition": {
      "$value": {
        "duration": "{motion.duration.fast}",
        "delay": "{motion.duration.instant}",
        "timingFunction": "{motion.easing.standard}"
      },
      "$type": "transition"
    },
    "transform": {
      "default": {
        "$value": "{motion.transform.none}",
        "$type": "string"
      },
      "hover": {
        "$value": "{motion.transform.none}",
        "$type": "string"
      },
      "pressed": {
        "$value": "{motion.transform.sink}",
        "$type": "string"
      },
      "focus": {
        "$value": "{motion.transform.none}",
        "$type": "string"
      },
      "disabled": {
        "$value": "{motion.transform.none}",
        "$type": "string"
      }
    }
  }
}
