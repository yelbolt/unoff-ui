{
  "$extensions": {
    "com.figma.modeName": "Penpot Dark"
  },
  "penpot": {
    "$type": "color",
    "$extensions": {
      "com.figma.scopes": ["ALL_SCOPES"]
    },
    "color": {
      "accent": {
        "default": {
          "$value": "#2E3434"
        },
        "primary": {
          "default": {
            "$value": "#7EFFF5"
          },
          "muted": {
            "$value": "#426158"
          }
        },
        "secondary": {
          "$value": "#BB97D8"
        },
        "tertiary": {
          "$value": "#00D1B8"
        },
        "quaternary": {
          "$value": "#FF6FE0"
        },
        "overlay": {
          "$value": "#7EFFF599"
        },
        "select": {
          "$value": "#00D1B81A"
        },
        "success": {
          "$value": "#2D9F8F"
        },
        "warning": {
          "$value": "#FE9C07"
        },
        "error": {
          "$value": "#C80857"
        },
        "info": {
          "$value": "#0E9BE9"
        }
      },
      "background": {
        "default": {
          "$value": "#18181A"
        },
        "primary": {
          "$value": "#18181A"
        },
        "secondary": {
          "$value": "#000"
        },
        "tertiary": {
          "$value": "#212426"
        },
        "quaternary": {
          "$value": "#2E3434"
        },
        "info": {
          "$value": "#082C49"
        },
        "success": {
          "$value": "#0A2927"
        },
        "warning": {
          "$value": "#3D2501"
        },
        "error": {
          "$value": "#500124"
        }
      },
      "foreground": {
        "primary": {
          "$value": "#FFF"
        },
        "secondary": {
          "$value": "#8F9DA3"
        },
        "disabled": {
          "$value": "#8F9DA366"
        },
        "error": {
          "$value": "#FF3277"
        }
      },
      "icon": {
        "default": {
          "$value": "#8F9DA3"
        }
      },
      "shadow": {
        "dark": {
          "$value": "#00000099"
        }
      },
      "overlay": {
        "default": {
          "$value": "#18181A99"
        },
        "onboarding": {
          "$value": "#18181AE6"
        }
      },
      "canvas": {
        "$value": "#BFBFBF"
      },
      "token": {
        "background": {
          "$value": "#272941"
        },
        "border": {
          "$value": "#484C74"
        },
        "accent": {
          "$value": "#6C6DAD"
        },
        "foreground": {
          "$value": "#A7A9FF"
        }
      }
    }
  },
  "motion": {
    "$description": "Semantic motion layer. Components never reach into the duration/easing/transform primitives directly — they go through these lanes so a mode can retime or immobilise the whole library.",
    "duration": {
      "$type": "duration",
      "$description": "Interaction lanes (instant/fast/base/slow) pace feedback the user triggers; `control` paces a control's own state travel and stays alive on every platform.",
      "instant": {
        "$value": "{duration.null}"
      },
      "fast": {
        "$value": "{duration.null}"
      },
      "base": {
        "$value": "{duration.null}"
      },
      "slow": {
        "$value": "{duration.null}"
      },
      "control": {
        "$value": "{duration.medium}"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "Motion character. `default` is the house curve.",
      "standard": {
        "$value": "{easing.standard}"
      },
      "entrance": {
        "$value": "{easing.decelerate}"
      },
      "exit": {
        "$value": "{easing.accelerate}"
      },
      "emphasis": {
        "$value": "{easing.emphasized}"
      }
    },
    "transform": {
      "$type": "string",
      "$description": "Interaction feedback expressed as a CSS transform function.",
      "none": {
        "$value": "{transform.none}"
      },
      "raise": {
        "$value": "{transform.none}"
      },
      "sink": {
        "$value": "{transform.none}"
      },
      "grow": {
        "$value": "{transform.none}"
      },
      "shrink": {
        "$value": "{transform.none}"
      }
    }
  }
}
