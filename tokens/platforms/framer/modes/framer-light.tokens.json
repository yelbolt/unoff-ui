      "thin": {
        "$value": "{scale.neg.unit}",
        "$type": "dimension"
      },
      "thick": {
        "$value": "{scale.neg.xunit}",
        "$type": "dimension"
      },
      "positive": {
        "thin": {
          "$value": "{scale.pos.unit}",
          "$type": "dimension"
        },
        "thick": {
          "$value": "{scale.pos.xunit}",
          "$type": "dimension"
        }
      }
    }
