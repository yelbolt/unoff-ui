{
  "$extensions": {
    "com.figma.modeName": "Framer Light"
  },
  "framer": {
    "$type": "color",
    "$extensions": {
      "com.figma.scopes": ["ALL_SCOPES"]
    },
    "color": {
      "bg": {
        "default": {
          "$value": "#FFFFFF"
        },
        "secondary": {
          "$value": "#F3F3F3"
        },
        "tertiary": {
          "$value": "#EEEEEE"
        }
      },
      "divider": {
        "$value": "#EEEEEE"
      },
      "tint": {
        "default": {
          "$value": "#0099FF"
        },
        "dimmed": {
          "$value": "#E5F5FF"
        },
        "dark": {
          "$value": "#0088FF"
        },
        "extraDark": {
          "$value": "#0077FF"
        }
      },
      "warning": {
        "default": {
          "$value": "#FFAA00"
        },
        "dimmed": {
          "$value": "#FFF6E5"
        },
        "dark": {
          "$value": "#FF9900"
        },
        "extraDark": {
          "$value": "#FF8800"
        }
      },
      "success": {
        "default": {
          "$value": "#33FF36"
        },
        "dimmed": {
          "$value": "#EBFFEB"
        },
        "dark": {
          "$value": "#22FF25"
        },
        "extraDark": {
          "$value": "#11FF14"
        }
      },
      "destructive": {
        "default": {
          "$value": "#FF3366"
        },
        "dimmed": {
          "$value": "#FFEBF0"
        },
        "dark": {
          "$value": "#EE2255"
        },
        "extraDark": {
          "$value": "#DD1144"
        }
      },
      "text": {
        "default": {
          "$value": "#333333"
        },
        "secondary": {
          "$value": "#666666"
        },
        "tertiary": {
          "$value": "#999999"
        },
        "reversed": {
          "$value": "#FFFFFF"
        }
      }
    }
  },
  "motion": {
    "$description": "Semantic motion layer. Components never reach into the duration/easing/transform primitives directly — they go through these lanes so a mode can retime or immobilise the whole library.",
    "duration": {
      "$type": "duration",
      "$description": "Interaction lanes (instant/fast/base/slow) pace feedback the user triggers; `control` paces a control's own state travel and stays alive on every platform.",
      "instant": {
        "$value": "{duration.null}"
      },
      "fast": {
        "$value": "{duration.null}"
      },
      "base": {
        "$value": "{duration.null}"
      },
      "slow": {
        "$value": "{duration.null}"
      },
      "control": {
        "$value": "{duration.medium}"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "Motion character. `default` is the house curve.",
      "standard": {
        "$value": "{easing.standard}"
      },
      "entrance": {
        "$value": "{easing.decelerate}"
      },
      "exit": {
        "$value": "{easing.accelerate}"
      },
      "emphasis": {
        "$value": "{easing.emphasized}"
      }
    },
    "transform": {
      "$type": "string",
      "$description": "Interaction feedback expressed as a CSS transform function.",
      "none": {
        "$value": "{transform.none}"
      },
      "raise": {
        "$value": "{transform.none}"
      },
      "sink": {
        "$value": "{transform.none}"
      },
      "grow": {
        "$value": "{transform.none}"
      },
      "shrink": {
        "$value": "{transform.none}"
      }
    }
  }
}
