  "type": {
    "size": {
      "01": {
        "$value": "{font.size.xsmall}",
        "$type": "dimension"
      },
      "02": {
        "$value": "{font.size.small}",
        "$type": "dimension"
      },
      "03": {
        "$value": "{font.size.medium}",
        "$type": "dimension"
      },
      "04": {
        "$value": "{font.size.large}",
        "$type": "dimension"
      },
      "05": {
        "$value": "{font.size.xlarge}",
        "$type": "dimension"
      },
      "00": {
        "$value": "{font.size.xxsmall}",
        "$type": "dimension"
      },
      "000": {
        "$value": "{font.size.xxxsmall}",
        "$type": "dimension"
      }
    },
    "leading": {
      "default": {
        "$value": "{font.lineHeight.default}",
        "$type": "number"
      },
      "large": {
        "$value": "{font.lineHeight.large}",
        "$type": "number"
      }
    },
    "tracking": {
      "small": {
        "$value": "{font.letterSpacing.pos.small}",
        "$type": "dimension"
      },
      "medium": {
        "$value": "{font.letterSpacing.pos.medium}",
        "$type": "dimension"
      },
      "large": {
        "$value": "{font.letterSpacing.pos.large}",
        "$type": "dimension"
      },
      "xlarge": {
        "$value": "{font.letterSpacing.pos.xlarge}",
        "$type": "dimension"
      }
    },
    "weight": {
      "400": {
        "$value": "{font.weight.normal}",
        "$type": "fontWeights"
      },
      "450": {
        "$value": "{font.weight.accent}",
        "$type": "fontWeights"
      },
      "500": {
        "$value": "{font.weight.medium}",
        "$type": "fontWeights"
      },
      "550": {
        "$value": "{font.weight.semi}",
        "$type": "fontWeights"
      },
      "600": {
        "$value": "{font.weight.bold}",
        "$type": "fontWeights"
      }
    }
  },
  "motion": {
    "$description": "Semantic motion layer. Components never reach into the duration/easing/transform primitives directly — they go through these lanes so a mode can retime or immobilise the whole library.",
    "duration": {
      "$type": "duration",
      "$description": "Interaction lanes (instant/fast/base/slow) pace feedback the user triggers; `control` paces a control's own state travel and stays alive on every platform.",
      "instant": {
        "$value": "{duration.null}"
      },
      "fast": {
        "$value": "{duration.null}"
      },
      "base": {
        "$value": "{duration.null}"
      },
      "slow": {
        "$value": "{duration.null}"
      },
      "control": {
        "$value": "{duration.medium}"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "$description": "Motion character. `default` is the house curve.",
      "standard": {
        "$value": "{easing.standard}"
      },
      "entrance": {
        "$value": "{easing.decelerate}"
      },
      "exit": {
        "$value": "{easing.accelerate}"
      },
      "emphasis": {
        "$value": "{easing.emphasized}"
      }
    },
    "transform": {
      "$type": "string",
      "$description": "Interaction feedback expressed as a CSS transform function.",
      "none": {
        "$value": "{transform.none}"
      },
      "raise": {
        "$value": "{transform.none}"
      },
      "sink": {
        "$value": "{transform.none}"
      },
      "grow": {
        "$value": "{transform.none}"
      },
      "shrink": {
        "$value": "{transform.none}"
      }
    }
  }
