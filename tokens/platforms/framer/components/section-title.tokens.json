{
  "sectionTitle": {
    "height": {
      "$value": "{control.size.800}",
      "$type": "dimension"
    },
    "gap": {
      "$value": "{space.gap.100}",
      "$type": "dimension"
    },
    "padding": {
      "top": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "right": {
        "$value": "{space.inset.100}",
        "$type": "dimension"
      },
      "bottom": {
        "$value": "{space.none}",
        "$type": "dimension"
      },
      "left": {
        "$value": "{space.inset.200}",
        "$type": "dimension"
      }
    },
    "text": {
      "font": {
        "family": {
          "$value": "{text.fontFamily}",
          "$type": "fontFamilies"
        },
        "size": {
          "$value": "{type.size.02}",
          "$type": "dimension"
        },
        "weight": {
          "$value": "{type.weight.600}",
          "$type": "fontWeights"
        }
      },
      "letterSpacing": {
        "$value": "{type.tracking.large}",
        "$type": "dimension"
      },
      "lineHeight": {
        "$value": "{type.leading.default}",
        "$type": "number"
      },
      "color": {
        "$value": "{framer.color.text.default}",
        "$type": "color"
      },
      "transform": {
        "$value": "none",
        "$type": "string"
      }
    },
    "info": {
      "icon": {
        "width": {
          "$value": "{control.icon.800}",
          "$type": "dimension"
        },
        "height": {
          "$value": "{control.icon.800}",
          "$type": "dimension"
        }
      }
    }
  }
}
