{
  "name": "Yelbolt Modes",
  "version": "2025.10",
  "description": "Mode tokens for Yelbolt brands platform — colors and dimensions, per brand and light/dark scheme",
  "resolutionOrder": [
    { "$ref": "#/sets/primitives" },
    { "$ref": "#/modifiers/mode" }
  ],
  "sets": {
    "primitives": {
      "description": "Yelbolt color primitives (shade ramps per family) plus the commons scale the dimension system draws from",
      "sources": [
        { "$ref": "./commons/commons.tokens.json" },
        { "$ref": "./platforms/yelbolt/colors.json" }
      ]
    }
  },
  "modifiers": {
    "mode": {
      "description": "Yelbolt brands light/dark modes — each context carries both a color and a dimension system",
      "contexts": {
        "isbLight": [
          { "$ref": "./platforms/yelbolt/modes/isb-light.tokens.json" }
        ],
        "isbDark": [
          { "$ref": "./platforms/yelbolt/modes/isb-dark.tokens.json" }
        ],
        "ntlLight": [
          { "$ref": "./platforms/yelbolt/modes/ntl-light.tokens.json" }
        ],
        "ntlDark": [
          { "$ref": "./platforms/yelbolt/modes/ntl-dark.tokens.json" }
        ],
        "tcnLight": [
          { "$ref": "./platforms/yelbolt/modes/tcn-light.tokens.json" }
        ],
        "tcnDark": [
          { "$ref": "./platforms/yelbolt/modes/tcn-dark.tokens.json" }
        ],
        "uicpLight": [
          { "$ref": "./platforms/yelbolt/modes/uicp-light.tokens.json" }
        ],
        "uicpDark": [
          { "$ref": "./platforms/yelbolt/modes/uicp-dark.tokens.json" }
        ],
        "uicsLight": [
          { "$ref": "./platforms/yelbolt/modes/uics-light.tokens.json" }
        ],
        "uicsDark": [
          { "$ref": "./platforms/yelbolt/modes/uics-dark.tokens.json" }
        ],
        "unoLight": [
          { "$ref": "./platforms/yelbolt/modes/uno-light.tokens.json" }
        ],
        "unoDark": [
          { "$ref": "./platforms/yelbolt/modes/uno-dark.tokens.json" }
        ],
        "ylbLight": [
          { "$ref": "./platforms/yelbolt/modes/ylb-light.tokens.json" }
        ],
        "ylbDark": [
          { "$ref": "./platforms/yelbolt/modes/ylb-dark.tokens.json" }
        ]
      },
      "default": "ylbLight"
    }
  }
}
